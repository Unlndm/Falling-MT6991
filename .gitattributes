# 模块内全是 shell / 文本文件，必须保持 LF。
# 真机 /system/bin/sh 是 mksh，CRLF 会让脚本执行异常；
# 且本地 Windows 的 core.autocrlf=true 会把 checkout 转成 CRLF。
* text=auto eol=lf

*.sh      text eol=lf
*.prop    text eol=lf
*.conf    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.rule    text eol=lf
*.xml     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.py      text eol=lf

# 模块安装脚本（META-INF）同样按 shell 处理
Falling-MT6991/META-INF/com/google/android/update-binary  text eol=lf
Falling-MT6991/META-INF/com/google/android/updater-script text eol=lf
Falling-MT6991/bin/falling_daemon text eol=lf
